{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
  },
  "workspace": {
    "checkThirdParty": false,
    "maxPreload": 100000,
    "preloadFileSize": 10000
  },
  "telemetry": {
    "enable": false
  },
  "completion": {
    "callSnippet": "Replace"
  }
}
